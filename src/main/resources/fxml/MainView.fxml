<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.MainController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Aplikasi Daftar Produk Toko" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleBukaFormInput" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="+ Tambah Produk Baru" />
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Cari Nama Produk:" />
            <TextField fx:id="txtCari" promptText="Masukkan nama produk..." HBox.hgrow="ALWAYS" />
            <Button onAction="#handleCari" prefWidth="55.0" text="Cari" />
         </children>
      </HBox>
      <TableView fx:id="tableProduk" prefHeight="300.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colKode" prefWidth="120.0" text="Kode Produk" />
          <TableColumn fx:id="colNama" prefWidth="220.0" text="Nama Produk" />
          <TableColumn fx:id="colKategori" prefWidth="130.0" text="Kategori" />
          <TableColumn fx:id="colHarga" prefWidth="130.0" text="Harga (Rp)" />
        </columns>
      </TableView>

      <HBox alignment="TOP_CENTER" spacing="250.0">
         <children>
         <!-- disini nyimpen button hapus data -->
            <Button defaultButton="true" lineSpacing="100.0" onAction="#handleHapus" prefHeight="25.0" prefWidth="162.0" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" text="Hapus Produk" />
            <Button contentDisplay="RIGHT" lineSpacing="100.0" onAction="#handleLihatDetail" prefWidth="160.0" style="-fx-background-color: #0288d1; -fx-text-fill: white;" text="Lihat Detail Produk" />
         </children>
      </HBox>
   </children>
</VBox>
